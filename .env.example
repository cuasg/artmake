# Copy to ".env" for local secrets.
# The MVP does not require any secrets; these are placeholders for later.
#
# OpenAI (living drawing → Refine with ChatGPT). You can instead set these in the Settings UI;
# otherwise the backend falls back to environment variables:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# Vision: larger preview + high detail helps match the photo (defaults are tuned for likeness):
# OPENAI_PREVIEW_MAX_SIDE=1536
# OPENAI_IMAGE_DETAIL=high
# OPENAI_VERBOSITY=medium
#
# ANTHROPIC_API_KEY=
# CONTROLLER_TOKEN=

